# Supabase (from Lovable project settings)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Shopify Storefront API (Sales channels > Headless > your storefront)
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=

# Public site URL (Vercel or custom domain) — used for Headless channel linking
VITE_STORE_URL=https://your-site.vercel.app
